# MealScript local environment (placeholders only — NEVER put a real token here)
# Copy this file to `.env` locally. `.env` is git-ignored.

# Your personal McDonald's MCP token (from https://open.mcd.cn/mcp)
MCD_MCP_TOKEN=

# Official remote MCP endpoint (Streamable HTTP)
MCD_MCP_URL=https://mcp.mcd.cn

# Default location used by the CLI when a .meal file does not specify one.
# `location` in MealScript is split into city + keyword to match the real
# query-nearby-stores schema, which has no single "location" parameter.
MCD_DEFAULT_CITY=北京市
MCD_DEFAULT_KEYWORD=海淀区五道口

# Live / Replay switch: "live" uses the real MCP server, "replay" uses fixtures/
MEALSCRIPT_MODE=replay
